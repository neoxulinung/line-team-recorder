LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=
# R2 (photo storage) - S3-compatible API credentials, separate from CF_API_TOKEN above.
# Generate from the Cloudflare dashboard: R2 -> Manage R2 API Tokens -> Create API token
# (permission: Object Read & Write, scoped to the bucket below).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket's public bucket.dev URL (Cloudflare dashboard -> your bucket -> Settings ->
# Public access -> enable -> copy the pub-*.r2.dev URL), no trailing slash.
R2_PUBLIC_BASE_URL=
LIFF_ID=
# Shared secret Cloud Scheduler must send as the x-scheduler-secret header on
# /internal/scheduled-organize. Generate any random string, e.g. `openssl rand -hex 32`.
SCHEDULER_SECRET=
# This channel's LINE basic ID add-friend link, e.g. https://line.me/R/ti/p/@xxxxxxx
# (LINE Developers Console -> Messaging API tab -> QR code / Bot basic ID, or
# GET https://api.line.me/v2/bot/info with the channel access token).
LINE_ADD_FRIEND_URL=
